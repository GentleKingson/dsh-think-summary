{
  "name": "dsh-think-summary",
  "version": "0.2.0",
  "description": "DSH plugin: detect long model thinking chains, segment them, and show per-segment summaries live in the chat UI, with a settings page.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "assets",
    "docs/compatibility-rc3.md",
    "docs/validation-rc3.md"
  ],
  "author": "zzj <3318897344@qq.com>",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -p tsconfig.json --watch",
    "watch:client": "node scripts/watch-client.mjs",
    "watch:all": "node scripts/watch-all.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && node scripts/seg-check.mjs && node scripts/order-check.mjs",
    "test:desktop": "node scripts/desktop-check.mjs",
    "test:live": "node scripts/live-check.mjs",
    "test:live-cancel": "node scripts/live-cancel-check.mjs"
  },
  "keywords": [
    "dsh",
    "cordis",
    "thinking",
    "reasoning",
    "summary"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.2-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.3",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
